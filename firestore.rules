rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(patientId) {
      return signedIn() && exists(/databases/$(database)/documents/patients/$(patientId)/members/$(request.auth.uid));
    }

    function memberRole(patientId) {
      return get(/databases/$(database)/documents/patients/$(patientId)/members/$(request.auth.uid)).data.role;
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /patients/{patientId} {
      allow read: if isMember(patientId);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isMember(patientId) && memberRole(patientId) in ['owner', 'caregiver', 'clinician'];
      allow delete: if false;

      match /members/{memberId} {
        allow read: if isMember(patientId);
        allow write: if isMember(patientId) && memberRole(patientId) == 'owner';
      }

      match /telemetry/{sampleId} {
        allow read: if isMember(patientId);
        allow create: if isMember(patientId) &&
          request.resource.data.keys().hasOnly([
            'heartRate', 'gsr', 'arousalScore', 'state', 'source',
            'deviceCapturedAt', 'storedAt', 'storedBy'
          ]) &&
          request.resource.data.heartRate is number &&
          request.resource.data.gsr is number &&
          request.resource.data.arousalScore is number &&
          request.resource.data.storedBy == request.auth.uid;
        allow update, delete: if false;
      }

      match /calibrations/{calibrationId} {
        allow read: if isMember(patientId);
        allow create: if isMember(patientId) && memberRole(patientId) in ['owner', 'caregiver', 'clinician'];
        allow update, delete: if false;
      }

      match /events/{eventId} {
        allow read, create: if isMember(patientId);
        allow update: if isMember(patientId) && memberRole(patientId) in ['owner', 'caregiver', 'clinician'];
        allow delete: if false;
      }
    }
  }
}
